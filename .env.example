# ---- Eitaa API (unused in web mode, but required by config) ----
EITAA_BOT_TOKEN=YOUR_EITAA_BOT_TOKEN_HERE
EITAA_API_MODE=eitaayar
EITAA_API_BASE_URL=https://eitaayar.ir/api

SOURCE_CHANNEL_ID=-1001234567890
ADMIN_IDS=

DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
FILES_DIR=./data/files

TRANSPORT=web
BROWSER=edge
CHROME_PROFILE_DIR=./data/chrome-profile
CHROME_BINARY=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
CHROMEDRIVER_PATH=./drivers/msedgedriver.exe
CHROME_WINDOW_SIZE=1280,900
WEB_HEADLESS=false
WEB_PAGE_LOAD_SECONDS=8
WEB_CHAT_OPEN_SECONDS=3
WEB_SEND_SETTLE_SECONDS=1.5
WEB_ATTACH_SETTLE_SECONDS=3

SEND_DELAY_SECONDS=60
SEND_INTERVAL_SECONDS=3.0
SEND_JITTER_RATIO=0.35
MAX_SENDS_PER_MINUTE=15
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=30

DAILY_REPORT_TIME=23:45
TIMEZONE=Asia/Tehran

ACTIVE_START_HOUR=5
ACTIVE_END_HOUR=24

REPEAT_ENABLED=true
REPEAT_IDLE_HOURS=1
REPEAT_LAST_N_POSTS=10
REPEAT_ACTIVE_START_HOUR=5
REPEAT_ACTIVE_END_HOUR=24

BUNDLE_ENABLED=true
BUNDLE_PREVIOUS_COUNT=9

PANEL_HOST=127.0.0.1
PANEL_PORT=8088
PANEL_USERNAME=admin
PANEL_PASSWORD=change-me

LOG_LEVEL=INFO
LOG_FILE=./data/logs/bot.log
